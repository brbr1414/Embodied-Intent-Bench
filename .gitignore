# ---------------------------------------------------------------------------
# Python (primary language of this repository)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
wheels/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Benchmark run outputs (results are regenerated, never committed)
results/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Generic build / temporary artifacts
# ---------------------------------------------------------------------------
build/
Build/
build-*/
*.tmp
*.log
*.bak
.cache/

# V2 aerial worlds: large source rasters stay local (provenance is committed instead)
src/v2_img/*.tif
src/v2_img/*.tiff
.DS_Store

# .venv may be a symlink to a venv outside the cloud-synced tree (OneDrive stalls on
# large venvs); ignore it in either form
.venv
